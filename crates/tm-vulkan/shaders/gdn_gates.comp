#version 450
// Qwen3.5 GDN scalar gate computation per `(t, vh)`:
//   g_exp[idx] = exp(softplus(alpha[idx] + dt_bias[vh]) * ssm_a[vh])
//   beta[idx]  = sigmoid(beta[idx])

layout(constant_id = 0) const uint WG = 64;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer Alpha  { float alpha[]; };
layout(std430, binding = 1) buffer Beta            { float beta[]; };
layout(std430, binding = 2) readonly buffer DtBias { float dt_bias[]; };
layout(std430, binding = 3) readonly buffer SsmA   { float ssm_a[]; };
layout(std430, binding = 4) writeonly buffer GExp  { float g_exp[]; };

layout(push_constant) uniform PC {
    uint n_v_heads;
    uint n_tok;
} pc;

void main() {
    const uint total = pc.n_tok * pc.n_v_heads;
    const uint stride = gl_NumWorkGroups.x * WG;
    for (uint idx = gl_GlobalInvocationID.x; idx < total; idx += stride) {
        const uint vh = idx % pc.n_v_heads;
        const float x = alpha[idx] + dt_bias[vh];
        const float sp = (x > 20.0) ? x : log(1.0 + exp(x));
        g_exp[idx] = exp(sp * ssm_a[vh]);
        beta[idx] = 1.0 / (1.0 + exp(-beta[idx]));
    }
}
