#version 450
// Deterministic Sparse MoE reduction & shared-expert 1D sigmoid gate residual add (`ADR-018`).
//   mode == 0: y[t, i] += sum_{s=0..k-1} src[(t * k + s) * n_embd + i]
//   mode == 1: y[t, i] += sigmoid(gate[t]) * src[t * n_embd + i]  (qwen2moe `ffn_gate_inp_shexp`)

layout(constant_id = 0) const uint WG = 256;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer SrcBuf  { float src[]; };
layout(std430, binding = 1) readonly buffer GateBuf { float gate[]; };
layout(std430, binding = 2) buffer          YBuf    { float y[]; };

layout(push_constant) uniform PC {
    uint n_embd;
    uint k;
    uint n_tok;
    uint mode;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint t = gl_WorkGroupID.y;
    if (i >= pc.n_embd || t >= pc.n_tok) return;

    if (pc.mode == 0u) {
        float acc = 0.0;
        const uint base = t * pc.k * pc.n_embd + i;
        for (uint s = 0u; s < pc.k; ++s) {
            acc += src[base + s * pc.n_embd];
        }
        y[t * pc.n_embd + i] += acc;
    } else {
        const float g = 1.0 / (1.0 + exp(-gate[t]));
        y[t * pc.n_embd + i] += g * src[t * pc.n_embd + i];
    }
}
