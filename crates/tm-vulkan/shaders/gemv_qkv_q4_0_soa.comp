#version 450
// Fused single-dispatch Q + K + V Q4_0 SoA GEMV using 64-bit coalesced loads (`LDG.E.64`).

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 4;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WQQ  { uvec2 wq_q[]; };
layout(std430, binding = 1) readonly buffer WQD  { uint16_t wq_d[]; };
layout(std430, binding = 2) readonly buffer WKQ  { uvec2 wk_q[]; };
layout(std430, binding = 3) readonly buffer WKD  { uint16_t wk_d[]; };
layout(std430, binding = 4) readonly buffer WVQ  { uvec2 wv_q[]; };
layout(std430, binding = 5) readonly buffer WVD  { uint16_t wv_d[]; };
layout(std430, binding = 6) readonly buffer X4   { vec4 x4[]; };
layout(std430, binding = 7) writeonly buffer QOut { float q_out[]; };
layout(std430, binding = 8) writeonly buffer KOut { float k_out[]; };
layout(std430, binding = 9) writeonly buffer VOut { float v_out[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint q_rows;
    uint k_rows;
    uint v_rows;
} pc;

void main() {
    const uint global_row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    const uint total_rows = pc.q_rows + pc.k_rows + pc.v_rows;
    if (global_row0 >= total_rows) return;

    uint which = 0u;
    uint local_row0 = global_row0;
    uint mat_rows = pc.q_rows;
    if (global_row0 >= pc.q_rows + pc.k_rows) {
        which = 2u;
        local_row0 = global_row0 - (pc.q_rows + pc.k_rows);
        mat_rows = pc.v_rows;
    } else if (global_row0 >= pc.q_rows) {
        which = 1u;
        local_row0 = global_row0 - pc.q_rows;
        mat_rows = pc.k_rows;
    }

    const uint nb = pc.n_in >> 5u;
    const uint lane = gl_SubgroupInvocationID;
    const uint sub = lane & 1u;
    const uint blk_step = gl_SubgroupSize >> 1u;

    float acc[NR];
    uint row_b[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        acc[r] = 0.0;
        row_b[r] = min(local_row0 + r, mat_rows - 1u) * nb;
    }

    for (uint ib = (lane >> 1u); ib < nb; ib += blk_step) {
        const uint xb = ib * 8u + sub * 2u;
        const vec4 xlo0 = x4[xb];
        const vec4 xlo1 = x4[xb + 1u];
        const vec4 xhi0 = x4[xb + 4u];
        const vec4 xhi1 = x4[xb + 5u];

        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            const uint bi = row_b[r] + ib;
            float d;
            uvec2 q2;
            if (which == 0u) {
                d = unpackHalf2x16(uint(wq_d[bi])).x;
                q2 = wq_q[bi * 2u + sub];
            } else if (which == 1u) {
                d = unpackHalf2x16(uint(wk_d[bi])).x;
                q2 = wk_q[bi * 2u + sub];
            } else {
                d = unpackHalf2x16(uint(wv_d[bi])).x;
                q2 = wv_q[bi * 2u + sub];
            }
            const uint u0 = q2.x;
            const uint u1 = q2.y;
            const float s = dot(vec4(u0 & 15u, (u0 >> 8u) & 15u, (u0 >> 16u) & 15u, (u0 >> 24u) & 15u) - 8.0, xlo0)
                          + dot(vec4((u0 >> 4u) & 15u, (u0 >> 12u) & 15u, (u0 >> 20u) & 15u, u0 >> 28u) - 8.0, xhi0)
                          + dot(vec4(u1 & 15u, (u1 >> 8u) & 15u, (u1 >> 16u) & 15u, (u1 >> 24u) & 15u) - 8.0, xlo1)
                          + dot(vec4((u1 >> 4u) & 15u, (u1 >> 12u) & 15u, (u1 >> 20u) & 15u, u1 >> 28u) - 8.0, xhi1);
            acc[r] = fma(d, s, acc[r]);
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float v = subgroupAdd(acc[r]);
        if (subgroupElect() && local_row0 + r < mat_rows) {
            if (which == 0u)      q_out[local_row0 + r] = v;
            else if (which == 1u) k_out[local_row0 + r] = v;
            else                  v_out[local_row0 + r] = v;
        }
    }
}
