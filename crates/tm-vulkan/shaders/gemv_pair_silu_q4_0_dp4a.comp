#version 450
// Fused FFN Gate + Up + SwiGLU AoS Q4_0 INT8 DP4A (`OpSDotKHR`) GEMV:
//   `y[row] = silu(dot(W_gate[row], x)) * dot(W_up[row], x)`
// Uses aligned 32-bit `w32` 2-block loads (`ip * 9u`) + hardware `sdot4x8`.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6018, 6019], id = 4450)
int sdot4x8(int a, int b, spirv_literal int packed_fmt);

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 2;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WGate   { uint16_t wg[]; };
layout(std430, binding = 0) readonly buffer WGate32 { uint wg32[]; };
layout(std430, binding = 1) readonly buffer WUp     { uint16_t wu[]; };
layout(std430, binding = 1) readonly buffer WUp32   { uint wu32[]; };
layout(std430, binding = 2) readonly buffer XQ      { int xq[]; };
layout(std430, binding = 3) readonly buffer XD      { vec2 xd[]; };
layout(std430, binding = 4) writeonly buffer Y      { float y[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
} pc;

void main() {
    const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    if (row0 >= pc.n_out) return;

    const uint nb = pc.n_in >> 5u;
    const uint lane = gl_SubgroupInvocationID;
    const uint sub = lane & 3u;
    const uint blk_step = gl_SubgroupSize >> 2u;

    float acc_g[NR];
    float acc_u[NR];
    uint row_b[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        acc_g[r] = 0.0;
        acc_u[r] = 0.0;
        row_b[r] = min(row0 + r, pc.n_out - 1u) * nb * 9u;
    }

    if ((nb & 1u) == 0u) {
        const uint np = nb >> 1u;
        for (uint ip = (lane >> 2u); ip < np; ip += blk_step) {
            const uint ib0 = ip << 1u;
            const uint ib1 = ib0 + 1u;
            const int xlo0 = xq[ib0 * 8u + sub];
            const int xhi0 = xq[ib0 * 8u + 4u + sub];
            const int xlo1 = xq[ib1 * 8u + sub];
            const int xhi1 = xq[ib1 * 8u + 4u + sub];
            const vec2 dm0 = xd[ib0];
            const vec2 dm1 = xd[ib1];
            const float m8_0 = (sub == 0u) ? (-8.0 * dm0.y) : 0.0;
            const float m8_1 = (sub == 0u) ? (-8.0 * dm1.y) : 0.0;
            const uint ip9 = ip * 9u;

            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                const uint b32 = (row_b[r] >> 1u) + ip9;

                const float dg0 = unpackHalf2x16(wg32[b32]).x;
                const uint ug0 = (wg32[b32 + sub] >> 16u) | (wg32[b32 + sub + 1u] << 16u);
                const float dg1 = unpackHalf2x16(wg32[b32 + 4u]).y;
                const uint ug1 = wg32[b32 + 5u + sub];

                const float du0 = unpackHalf2x16(wu32[b32]).x;
                const uint uu0 = (wu32[b32 + sub] >> 16u) | (wu32[b32 + sub + 1u] << 16u);
                const float du1 = unpackHalf2x16(wu32[b32 + 4u]).y;
                const uint uu1 = wu32[b32 + 5u + sub];

                const int sg0 = sdot4x8(int(ug0 & 0x0F0F0F0Fu), xlo0, 0)
                              + sdot4x8(int((ug0 >> 4u) & 0x0F0F0F0Fu), xhi0, 0);
                const int sg1 = sdot4x8(int(ug1 & 0x0F0F0F0Fu), xlo1, 0)
                              + sdot4x8(int((ug1 >> 4u) & 0x0F0F0F0Fu), xhi1, 0);
                const int su0 = sdot4x8(int(uu0 & 0x0F0F0F0Fu), xlo0, 0)
                              + sdot4x8(int((uu0 >> 4u) & 0x0F0F0F0Fu), xhi0, 0);
                const int su1 = sdot4x8(int(uu1 & 0x0F0F0F0Fu), xlo1, 0)
                              + sdot4x8(int((uu1 >> 4u) & 0x0F0F0F0Fu), xhi1, 0);

                acc_g[r] = fma(dg1, fma(float(sg1), dm1.x, m8_1),
                           fma(dg0, fma(float(sg0), dm0.x, m8_0), acc_g[r]));
                acc_u[r] = fma(du1, fma(float(su1), dm1.x, m8_1),
                           fma(du0, fma(float(su0), dm0.x, m8_0), acc_u[r]));
            }
        }
    } else {
        for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
            const int xlo = xq[ib * 8u + sub];
            const int xhi = xq[ib * 8u + 4u + sub];
            const vec2 dm = xd[ib];
            const float m8 = (sub == 0u) ? (-8.0 * dm.y) : 0.0;
            const uint ib9 = ib * 9u;
            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                const uint base = row_b[r] + ib9;
                const float dg = unpackHalf2x16(uint(wg[base])).x;
                const float du = unpackHalf2x16(uint(wu[base])).x;
                const uint ug = uint(wg[base + 1u + 2u * sub]) | (uint(wg[base + 2u + 2u * sub]) << 16u);
                const uint uu = uint(wu[base + 1u + 2u * sub]) | (uint(wu[base + 2u + 2u * sub]) << 16u);
                const int sg_dot = sdot4x8(int(ug & 0x0F0F0F0Fu), xlo, 0)
                                 + sdot4x8(int((ug >> 4u) & 0x0F0F0F0Fu), xhi, 0);
                const int su_dot = sdot4x8(int(uu & 0x0F0F0F0Fu), xlo, 0)
                                 + sdot4x8(int((uu >> 4u) & 0x0F0F0F0Fu), xhi, 0);
                acc_g[r] = fma(dg, fma(float(sg_dot), dm.x, m8), acc_g[r]);
                acc_u[r] = fma(du, fma(float(su_dot), dm.x, m8), acc_u[r]);
            }
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float g = subgroupAdd(acc_g[r]);
        const float u = subgroupAdd(acc_u[r]);
        if (subgroupElect() && row0 + r < pc.n_out) {
            y[row0 + r] = (g / (1.0 + exp(-g))) * u;
        }
    }
}
