#version 450
// 2-lane-per-block 64-bit coalesced (`LDG.E.64`) Q4_0 SoA INT8 DP4A (`OpSDotKHR`) GEMV.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6018, 6019], id = 4450)
int sdot4x8(int a, int b, spirv_literal int packed_fmt);

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 4;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WQ64 { uvec2 wq64[]; };
layout(std430, binding = 1) readonly buffer WD   { uint16_t wd[]; };
layout(std430, binding = 2) readonly buffer XQ   { int xq[]; };
layout(std430, binding = 3) readonly buffer XD   { vec2 xd[]; };
layout(std430, binding = 4) buffer Y             { float y[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint add_residual;
    uint _pad;
} pc;

void main() {
    const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    if (row0 >= pc.n_out) return;

    const uint nb = pc.n_in >> 5u;
    const uint lane = gl_SubgroupInvocationID;
    const uint sub = lane & 1u;
    const uint blk_step = gl_SubgroupSize >> 1u;

    float acc[NR];
    uint row_b[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        acc[r] = 0.0;
        row_b[r] = min(row0 + r, pc.n_out - 1u) * nb;
    }

    for (uint ib = (lane >> 1u); ib < nb; ib += blk_step) {
        const uint xb = ib * 8u + sub * 2u;
        const int xlo0 = xq[xb];
        const int xlo1 = xq[xb + 1u];
        const int xhi0 = xq[xb + 4u];
        const int xhi1 = xq[xb + 5u];
        const vec2 dm = xd[ib];
        const float m8 = (sub == 0u) ? (-8.0 * dm.y) : 0.0;

        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            const uint bi = row_b[r] + ib;
            const float d = unpackHalf2x16(uint(wd[bi])).x;
            const uvec2 q2 = wq64[bi * 2u + sub];
            const uint u0 = q2.x;
            const uint u1 = q2.y;
            const int s = sdot4x8(int(u0 & 0x0F0F0F0Fu), xlo0, 0)
                        + sdot4x8(int((u0 >> 4u) & 0x0F0F0F0Fu), xhi0, 0)
                        + sdot4x8(int(u1 & 0x0F0F0F0Fu), xlo1, 0)
                        + sdot4x8(int((u1 >> 4u) & 0x0F0F0F0Fu), xhi1, 0);
            acc[r] = fma(d, fma(float(s), dm.x, m8), acc[r]);
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float out_v = subgroupAdd(acc[r]);
        if (subgroupElect() && row0 + r < pc.n_out) {
            const uint yi = row0 + r;
            y[yi] = (pc.add_residual != 0u) ? (y[yi] + out_v) : out_v;
        }
    }
}
