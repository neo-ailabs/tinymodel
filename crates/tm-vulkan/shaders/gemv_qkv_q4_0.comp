#version 450
// Fused single-dispatch Q + K + V Q4_0 GEMV for single-token decode.
// Each subgroup handles NR = 2 consecutive rows of whichever projection (`q`, `k`, or `v`)
// `global_row0` falls in (`q_rows` and `k_rows` must be multiples of NR).

#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 2;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WQ { uint16_t wq[]; };
layout(std430, binding = 1) readonly buffer WK { uint16_t wk[]; };
layout(std430, binding = 2) readonly buffer WV { uint16_t wv[]; };
layout(std430, binding = 3) readonly buffer X  { vec4 x4[]; };
layout(std430, binding = 4) writeonly buffer QOut { float q_out[]; };
layout(std430, binding = 5) writeonly buffer KOut { float k_out[]; };
layout(std430, binding = 6) writeonly buffer VOut { float v_out[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint q_rows;
    uint k_rows;
    uint v_rows;
} pc;

void main() {
    const uint global_row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    const uint total_rows = pc.q_rows + pc.k_rows + pc.v_rows;
    if (global_row0 >= total_rows) return;

    uint which = 0u;
    uint local_row0 = global_row0;
    uint mat_rows = pc.q_rows;
    if (global_row0 >= pc.q_rows + pc.k_rows) {
        which = 2u;
        local_row0 = global_row0 - (pc.q_rows + pc.k_rows);
        mat_rows = pc.v_rows;
    } else if (global_row0 >= pc.q_rows) {
        which = 1u;
        local_row0 = global_row0 - pc.q_rows;
        mat_rows = pc.k_rows;
    }

    const uint nb = pc.n_in / 32u;
    float acc[NR];
    for (uint r = 0u; r < NR; ++r) acc[r] = 0.0;

    for (uint ib = gl_SubgroupInvocationID; ib < nb; ib += gl_SubgroupSize) {
        const uint xb = ib * 8u;
        vec4 xv0 = x4[xb + 0u];
        vec4 xv1 = x4[xb + 1u];
        vec4 xv2 = x4[xb + 2u];
        vec4 xv3 = x4[xb + 3u];
        vec4 xv4 = x4[xb + 4u];
        vec4 xv5 = x4[xb + 5u];
        vec4 xv6 = x4[xb + 6u];
        vec4 xv7 = x4[xb + 7u];

        for (uint r = 0u; r < NR; ++r) {
            const uint row = min(local_row0 + r, mat_rows - 1u);
            const uint base = (row * nb + ib) * 9u;
            float d;
            uint u0, u1, u2, u3;
            if (which == 0u) {
                d  = unpackHalf2x16(uint(wq[base])).x;
                u0 = uint(wq[base + 1u]) | (uint(wq[base + 2u]) << 16u);
                u1 = uint(wq[base + 3u]) | (uint(wq[base + 4u]) << 16u);
                u2 = uint(wq[base + 5u]) | (uint(wq[base + 6u]) << 16u);
                u3 = uint(wq[base + 7u]) | (uint(wq[base + 8u]) << 16u);
            } else if (which == 1u) {
                d  = unpackHalf2x16(uint(wk[base])).x;
                u0 = uint(wk[base + 1u]) | (uint(wk[base + 2u]) << 16u);
                u1 = uint(wk[base + 3u]) | (uint(wk[base + 4u]) << 16u);
                u2 = uint(wk[base + 5u]) | (uint(wk[base + 6u]) << 16u);
                u3 = uint(wk[base + 7u]) | (uint(wk[base + 8u]) << 16u);
            } else {
                d  = unpackHalf2x16(uint(wv[base])).x;
                u0 = uint(wv[base + 1u]) | (uint(wv[base + 2u]) << 16u);
                u1 = uint(wv[base + 3u]) | (uint(wv[base + 4u]) << 16u);
                u2 = uint(wv[base + 5u]) | (uint(wv[base + 6u]) << 16u);
                u3 = uint(wv[base + 7u]) | (uint(wv[base + 8u]) << 16u);
            }

            float s = 0.0;
            s += dot(vec4(u0 & 15u, (u0 >> 8u) & 15u, (u0 >> 16u) & 15u, (u0 >> 24u) & 15u) - 8.0, xv0);
            s += dot(vec4((u0 >> 4u) & 15u, (u0 >> 12u) & 15u, (u0 >> 20u) & 15u, u0 >> 28u) - 8.0, xv4);
            s += dot(vec4(u1 & 15u, (u1 >> 8u) & 15u, (u1 >> 16u) & 15u, (u1 >> 24u) & 15u) - 8.0, xv1);
            s += dot(vec4((u1 >> 4u) & 15u, (u1 >> 12u) & 15u, (u1 >> 20u) & 15u, u1 >> 28u) - 8.0, xv5);
            s += dot(vec4(u2 & 15u, (u2 >> 8u) & 15u, (u2 >> 16u) & 15u, (u2 >> 24u) & 15u) - 8.0, xv2);
            s += dot(vec4((u2 >> 4u) & 15u, (u2 >> 12u) & 15u, (u2 >> 20u) & 15u, u2 >> 28u) - 8.0, xv6);
            s += dot(vec4(u3 & 15u, (u3 >> 8u) & 15u, (u3 >> 16u) & 15u, (u3 >> 24u) & 15u) - 8.0, xv3);
            s += dot(vec4((u3 >> 4u) & 15u, (u3 >> 12u) & 15u, (u3 >> 20u) & 15u, u3 >> 28u) - 8.0, xv7);
            acc[r] = fma(d, s, acc[r]);
        }
    }

    for (uint r = 0u; r < NR; ++r) {
        const float v = subgroupAdd(acc[r]);
        if (subgroupElect() && local_row0 + r < mat_rows) {
            if (which == 0u)      q_out[local_row0 + r] = v;
            else if (which == 1u) k_out[local_row0 + r] = v;
            else                  v_out[local_row0 + r] = v;
        }
    }
}
