#version 450
// Fused 2-matrix Q4_0 SoA GEMV sharing input `x` (`ya = Wa * x`, `yb = Wb * x`) in 1 dispatch.
// Uses 2-lane-per-block 64-bit coalesced loads (`LDG.E.64`), zero subgroupShuffle.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 4;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WAQ { uvec2 wa_q[]; };
layout(std430, binding = 1) readonly buffer WAD { uint16_t wa_d[]; };
layout(std430, binding = 2) readonly buffer WBQ { uvec2 wb_q[]; };
layout(std430, binding = 3) readonly buffer WBD { uint16_t wb_d[]; };
layout(std430, binding = 4) readonly buffer X4  { vec4 x4[]; };
layout(std430, binding = 5) writeonly buffer YA { float ya[]; };
layout(std430, binding = 6) writeonly buffer YB { float yb[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint a_rows;
    uint b_rows;
    uint _pad;
} pc;

void main() {
    const uint global_row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    const uint total_rows = pc.a_rows + pc.b_rows;
    if (global_row0 >= total_rows) return;

    const bool is_b = (global_row0 >= pc.a_rows);
    const uint local_row0 = is_b ? (global_row0 - pc.a_rows) : global_row0;
    const uint mat_rows = is_b ? pc.b_rows : pc.a_rows;

    const uint nb = pc.n_in >> 5u;
    const uint lane = gl_SubgroupInvocationID;
    const uint sub = lane & 1u;
    const uint blk_step = gl_SubgroupSize >> 1u;

    float acc[NR];
    uint row_b[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        acc[r] = 0.0;
        row_b[r] = min(local_row0 + r, mat_rows - 1u) * nb;
    }

    for (uint ib = (lane >> 1u); ib < nb; ib += blk_step) {
        const uint xb = ib * 8u + sub * 2u;
        const vec4 xlo0 = x4[xb];
        const vec4 xlo1 = x4[xb + 1u];
        const vec4 xhi0 = x4[xb + 4u];
        const vec4 xhi1 = x4[xb + 5u];

        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            const uint bi = row_b[r] + ib;
            float d;
            uvec2 q2;
            if (is_b) {
                d = unpackHalf2x16(uint(wb_d[bi])).x;
                q2 = wb_q[bi * 2u + sub];
            } else {
                d = unpackHalf2x16(uint(wa_d[bi])).x;
                q2 = wa_q[bi * 2u + sub];
            }
            const uint u0 = q2.x;
            const uint u1 = q2.y;
            const float s = dot(vec4(u0 & 15u, (u0 >> 8u) & 15u, (u0 >> 16u) & 15u, (u0 >> 24u) & 15u) - 8.0, xlo0)
                          + dot(vec4((u0 >> 4u) & 15u, (u0 >> 12u) & 15u, (u0 >> 20u) & 15u, u0 >> 28u) - 8.0, xhi0)
                          + dot(vec4(u1 & 15u, (u1 >> 8u) & 15u, (u1 >> 16u) & 15u, (u1 >> 24u) & 15u) - 8.0, xlo1)
                          + dot(vec4((u1 >> 4u) & 15u, (u1 >> 12u) & 15u, (u1 >> 20u) & 15u, u1 >> 28u) - 8.0, xhi1);
            acc[r] = fma(d, s, acc[r]);
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float out_v = subgroupAdd(acc[r]);
        if (subgroupElect() && local_row0 + r < mat_rows) {
            if (is_b) {
                yb[local_row0 + r] = out_v;
            } else {
                ya[local_row0 + r] = out_v;
            }
        }
    }
}
