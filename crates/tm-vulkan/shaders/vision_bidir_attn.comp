#version 450
// Subgroup-portable LDS-tiled Bidirectional Full Multi-Head Self-Attention for ViT (`VisionVkRunner`).
// Works for any head_dim <= 256 (multiple of 4, e.g., 64, 72, 80, 96, 128) and any subgroup size {8,16,32,64}.
// Uses 16 KB shared memory (8 KB K + 8 KB V, fits Mali / Intel / RADV / NVIDIA / lavapipe).

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint WG = 256;
layout(constant_id = 1) const uint N_VEC = 8;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer QBuf   { vec4 q4[]; };
layout(std430, binding = 1) readonly buffer KBuf   { vec4 k4[]; };
layout(std430, binding = 2) readonly buffer VBuf   { vec4 v4[]; };
layout(std430, binding = 3) writeonly buffer OutBuf { vec4 out4[]; };

layout(push_constant) uniform PC {
    uint n_heads;
    uint head_dim;
    uint n_seq;
} pc;

const uint BR = 8u;
const uint BC = 8u;
const uint MAX_HD4 = 64u; // head_dim <= 256

shared vec4 k_sh[BC * MAX_HD4];
shared vec4 v_sh[BC * MAX_HD4];

void main() {
    const uint head = gl_WorkGroupID.x;
    const uint tile_q0 = gl_WorkGroupID.y * BR;
    if (head >= pc.n_heads || tile_q0 >= pc.n_seq) return;

    const uint tid = gl_LocalInvocationID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint sg_size = gl_SubgroupSize;

    const uint hd4 = pc.head_dim >> 2u;
    const uint d_vit4 = pc.n_heads * hd4;
    const float scale = inversesqrt(float(pc.head_dim));

    const uint q_tok = tile_q0 + sg;
    const bool valid_q = (q_tok < pc.n_seq);

    vec4 q_local[N_VEC];
    vec4 o_local[N_VEC];
    [[unroll]] for (uint k = 0u; k < N_VEC; ++k) {
        const uint d4 = k * sg_size + lane;
        q_local[k] = (valid_q && d4 < hd4) ? (q4[q_tok * d_vit4 + head * hd4 + d4] * scale) : vec4(0.0);
        o_local[k] = vec4(0.0);
    }

    float m_local = -1.0e30;
    float l_local = 0.0;
    const uint total_kv4 = BC * hd4;

    for (uint kv_t0 = 0u; kv_t0 < pc.n_seq; kv_t0 += BC) {
        for (uint idx = tid; idx < total_kv4; idx += WG) {
            const uint kc = idx / hd4;
            const uint d4 = idx % hd4;
            const uint kv_pos = kv_t0 + kc;
            if (kv_pos < pc.n_seq) {
                const uint g_off = kv_pos * d_vit4 + head * hd4 + d4;
                k_sh[kc * MAX_HD4 + d4] = k4[g_off];
                v_sh[kc * MAX_HD4 + d4] = v4[g_off];
            } else {
                k_sh[kc * MAX_HD4 + d4] = vec4(0.0);
                v_sh[kc * MAX_HD4 + d4] = vec4(0.0);
            }
        }
        barrier();

        const uint kc_end = valid_q ? min(BC, pc.n_seq - kv_t0) : 0u;
        for (uint kc = 0u; kc < kc_end; ++kc) {
            const uint sh_row = kc * MAX_HD4;
            float dot_val = 0.0;
            [[unroll]] for (uint k = 0u; k < N_VEC; ++k) {
                const uint d4 = k * sg_size + lane;
                if (d4 < hd4) {
                    dot_val += dot(q_local[k], k_sh[sh_row + d4]);
                }
            }
            dot_val = subgroupAdd(dot_val);

            const float m_new = max(m_local, dot_val);
            const float alpha = (l_local == 0.0) ? 0.0 : exp(m_local - m_new);
            const float p = exp(dot_val - m_new);
            l_local = l_local * alpha + p;
            m_local = m_new;

            [[unroll]] for (uint k = 0u; k < N_VEC; ++k) {
                const uint d4 = k * sg_size + lane;
                if (d4 < hd4) {
                    o_local[k] = fma(vec4(p), v_sh[sh_row + d4], o_local[k] * alpha);
                }
            }
        }

        barrier();
    }

    if (valid_q) {
        const float inv_l = (l_local > 0.0) ? (1.0 / l_local) : 0.0;
        const uint ob = q_tok * d_vit4 + head * hd4;
        [[unroll]] for (uint k = 0u; k < N_VEC; ++k) {
            const uint d4 = k * sg_size + lane;
            if (d4 < hd4) {
                out4[ob + d4] = o_local[k] * inv_l;
            }
        }
    }
}
