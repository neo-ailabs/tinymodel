#version 450
// Fused single-dispatch Q + K + V AoS Q4_0 INT8 DP4A (`OpSDotKHR`) GEMV.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6018, 6019], id = 4450)
int sdot4x8(int a, int b, spirv_literal int packed_fmt);

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 2;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WQ   { uint16_t wq[]; };
layout(std430, binding = 0) readonly buffer WQ32 { uint wq32[]; };
layout(std430, binding = 1) readonly buffer WK   { uint16_t wk[]; };
layout(std430, binding = 1) readonly buffer WK32 { uint wk32[]; };
layout(std430, binding = 2) readonly buffer WV   { uint16_t wv[]; };
layout(std430, binding = 2) readonly buffer WV32 { uint wv32[]; };
layout(std430, binding = 3) readonly buffer XQ   { int xq[]; };
layout(std430, binding = 4) readonly buffer XD   { vec2 xd[]; };
layout(std430, binding = 5) writeonly buffer QOut { float q_out[]; };
layout(std430, binding = 6) writeonly buffer KOut { float k_out[]; };
layout(std430, binding = 7) writeonly buffer VOut { float v_out[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint q_rows;
    uint k_rows;
    uint v_rows;
} pc;

void main() {
    const uint global_row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    const uint total_rows = pc.q_rows + pc.k_rows + pc.v_rows;
    if (global_row0 >= total_rows) return;

    uint which = 0u;
    uint local_row0 = global_row0;
    uint mat_rows = pc.q_rows;
    if (global_row0 >= pc.q_rows + pc.k_rows) {
        which = 2u;
        local_row0 = global_row0 - (pc.q_rows + pc.k_rows);
        mat_rows = pc.v_rows;
    } else if (global_row0 >= pc.q_rows) {
        which = 1u;
        local_row0 = global_row0 - pc.q_rows;
        mat_rows = pc.k_rows;
    }

    const uint nb = pc.n_in >> 5u;
    const uint lane = gl_SubgroupInvocationID;
    const uint sub = lane & 3u;
    const uint blk_step = gl_SubgroupSize >> 2u;

    float acc[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) acc[r] = 0.0;

    if ((nb & 1u) == 0u) {
        const uint np = nb >> 1u;
        const uint row_u32 = np * 9u;
        for (uint ip = (lane >> 2u); ip < np; ip += blk_step) {
            const uint ib0 = ip << 1u;
            const uint ib1 = ib0 + 1u;
            const int xlo0 = xq[ib0 * 8u + sub];
            const int xhi0 = xq[ib0 * 8u + 4u + sub];
            const int xlo1 = xq[ib1 * 8u + sub];
            const int xhi1 = xq[ib1 * 8u + 4u + sub];
            const vec2 dm0 = xd[ib0];
            const vec2 dm1 = xd[ib1];
            const float m8_0 = (sub == 0u) ? (-8.0 * dm0.y) : 0.0;
            const float m8_1 = (sub == 0u) ? (-8.0 * dm1.y) : 0.0;
            const uint ip9 = ip * 9u;

            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                const uint row = min(local_row0 + r, mat_rows - 1u);
                const uint b32 = row * row_u32 + ip9;
                float d0, d1;
                uint u0, u1;
                if (which == 0u) {
                    d0 = unpackHalf2x16(wq32[b32]).x;
                    u0 = (wq32[b32 + sub] >> 16u) | (wq32[b32 + sub + 1u] << 16u);
                    d1 = unpackHalf2x16(wq32[b32 + 4u]).y;
                    u1 = wq32[b32 + 5u + sub];
                } else if (which == 1u) {
                    d0 = unpackHalf2x16(wk32[b32]).x;
                    u0 = (wk32[b32 + sub] >> 16u) | (wk32[b32 + sub + 1u] << 16u);
                    d1 = unpackHalf2x16(wk32[b32 + 4u]).y;
                    u1 = wk32[b32 + 5u + sub];
                } else {
                    d0 = unpackHalf2x16(wv32[b32]).x;
                    u0 = (wv32[b32 + sub] >> 16u) | (wv32[b32 + sub + 1u] << 16u);
                    d1 = unpackHalf2x16(wv32[b32 + 4u]).y;
                    u1 = wv32[b32 + 5u + sub];
                }
                const int s0 = sdot4x8(int(u0 & 0x0F0F0F0Fu), xlo0, 0)
                             + sdot4x8(int((u0 >> 4u) & 0x0F0F0F0Fu), xhi0, 0);
                const int s1 = sdot4x8(int(u1 & 0x0F0F0F0Fu), xlo1, 0)
                             + sdot4x8(int((u1 >> 4u) & 0x0F0F0F0Fu), xhi1, 0);
                acc[r] = fma(d1, fma(float(s1), dm1.x, m8_1),
                         fma(d0, fma(float(s0), dm0.x, m8_0), acc[r]));
            }
        }
    } else {
        for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
            const int xlo = xq[ib * 8u + sub];
            const int xhi = xq[ib * 8u + 4u + sub];
            const vec2 dm = xd[ib];
            const float m8 = (sub == 0u) ? (-8.0 * dm.y) : 0.0;
            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                const uint row = min(local_row0 + r, mat_rows - 1u);
                const uint base = (row * nb + ib) * 9u;
                float d;
                uint u;
                if (which == 0u) {
                    d = unpackHalf2x16(uint(wq[base])).x;
                    u = uint(wq[base + 1u + 2u * sub]) | (uint(wq[base + 2u + 2u * sub]) << 16u);
                } else if (which == 1u) {
                    d = unpackHalf2x16(uint(wk[base])).x;
                    u = uint(wk[base + 1u + 2u * sub]) | (uint(wk[base + 2u + 2u * sub]) << 16u);
                } else {
                    d = unpackHalf2x16(uint(wv[base])).x;
                    u = uint(wv[base + 1u + 2u * sub]) | (uint(wv[base + 2u + 2u * sub]) << 16u);
                }
                const int s = sdot4x8(int(u & 0x0F0F0F0Fu), xlo, 0)
                            + sdot4x8(int((u >> 4u) & 0x0F0F0F0Fu), xhi, 0);
                acc[r] = fma(d, fma(float(s), dm.x, m8), acc[r]);
            }
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float v = subgroupAdd(acc[r]);
        if (subgroupElect() && local_row0 + r < mat_rows) {
            if (which == 0u)      q_out[local_row0 + r] = v;
            else if (which == 1u) k_out[local_row0 + r] = v;
            else                  v_out[local_row0 + r] = v;
        }
    }
}
