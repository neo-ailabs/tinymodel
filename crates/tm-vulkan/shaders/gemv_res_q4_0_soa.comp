#version 450
// 2-lane-per-block 64-bit coalesced (`LDG.E.64`) Q4_0 SoA GEMV with optional fused residual add.
// Weight layout: `wq64` holds 16 packed nibble bytes per block as 2 x uvec2 (16B-aligned),
// `wd` holds the fp16 scale per block (2B). Zero extra VRAM vs AoS, zero subgroupShuffle.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 4;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WQ64 { uvec2 wq64[]; };
layout(std430, binding = 1) readonly buffer WD   { uint16_t wd[]; };
layout(std430, binding = 2) readonly buffer X4   { vec4 x4[]; };
layout(std430, binding = 3) buffer Y             { float y[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint add_residual;
    uint _pad;
} pc;

void main() {
    const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    if (row0 >= pc.n_out) return;

    const uint nb = pc.n_in >> 5u;
    const uint lane = gl_SubgroupInvocationID;
    const uint sub = lane & 1u;
    const uint blk_step = gl_SubgroupSize >> 1u;

    float acc[NR];
    uint row_b[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        acc[r] = 0.0;
        row_b[r] = min(row0 + r, pc.n_out - 1u) * nb;
    }

    for (uint ib = (lane >> 1u); ib < nb; ib += blk_step) {
        const uint xb = ib * 8u + sub * 2u;
        const vec4 xlo0 = x4[xb];
        const vec4 xlo1 = x4[xb + 1u];
        const vec4 xhi0 = x4[xb + 4u];
        const vec4 xhi1 = x4[xb + 5u];

        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            const uint bi = row_b[r] + ib;
            const float d = unpackHalf2x16(uint(wd[bi])).x;
            const uvec2 q2 = wq64[bi * 2u + sub];
            const uint u0 = q2.x;
            const uint u1 = q2.y;
            const float s = dot(vec4(u0 & 15u, (u0 >> 8u) & 15u, (u0 >> 16u) & 15u, (u0 >> 24u) & 15u) - 8.0, xlo0)
                          + dot(vec4((u0 >> 4u) & 15u, (u0 >> 12u) & 15u, (u0 >> 20u) & 15u, u0 >> 28u) - 8.0, xhi0)
                          + dot(vec4(u1 & 15u, (u1 >> 8u) & 15u, (u1 >> 16u) & 15u, (u1 >> 24u) & 15u) - 8.0, xlo1)
                          + dot(vec4((u1 >> 4u) & 15u, (u1 >> 12u) & 15u, (u1 >> 20u) & 15u, u1 >> 28u) - 8.0, xhi1);
            acc[r] = fma(d, s, acc[r]);
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float out_v = subgroupAdd(acc[r]);
        if (subgroupElect() && row0 + r < pc.n_out) {
            const uint yi = row0 + r;
            y[yi] = (pc.add_residual != 0u) ? (y[yi] + out_v) : out_v;
        }
    }
}
