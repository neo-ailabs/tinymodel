#version 450
// Elementwise sigmoid gating for Qwen3.5 full-attention output:
// out_v[i] *= sigmoid(gate[i]) (grid-strided so `gx <= 65535` on all GPUs).

layout(constant_id = 0) const uint WG = 256;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) buffer Out { float out_v[]; };
layout(std430, binding = 1) readonly buffer Gate { float gate[]; };

layout(push_constant) uniform PC {
    uint n;
} pc;

void main() {
    const uint stride = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) {
        out_v[i] *= 1.0 / (1.0 + exp(-gate[i]));
    }
}
