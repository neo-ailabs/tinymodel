#version 450
// Fused FFN Gate + Up + SwiGLU Q4_0 SoA INT8 DP4A (`OpSDotKHR`) GEMV (`LDG.E.64`).

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6018, 6019], id = 4450)
int sdot4x8(int a, int b, spirv_literal int packed_fmt);

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint NR = 2;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer WGateQ { uvec2 wg_q[]; };
layout(std430, binding = 1) readonly buffer WGateD { uint16_t wg_d[]; };
layout(std430, binding = 2) readonly buffer WUpQ   { uvec2 wu_q[]; };
layout(std430, binding = 3) readonly buffer WUpD   { uint16_t wu_d[]; };
layout(std430, binding = 4) readonly buffer XQ     { int xq[]; };
layout(std430, binding = 5) readonly buffer XD     { vec2 xd[]; };
layout(std430, binding = 6) writeonly buffer Y     { float y[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
} pc;

void main() {
    const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    if (row0 >= pc.n_out) return;

    const uint nb = pc.n_in >> 5u;
    const uint lane = gl_SubgroupInvocationID;
    const uint sub = lane & 1u;
    const uint blk_step = gl_SubgroupSize >> 1u;

    float acc_g[NR];
    float acc_u[NR];
    uint row_b[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        acc_g[r] = 0.0;
        acc_u[r] = 0.0;
        row_b[r] = min(row0 + r, pc.n_out - 1u) * nb;
    }

    for (uint ib = (lane >> 1u); ib < nb; ib += blk_step) {
        const uint xb = ib * 8u + sub * 2u;
        const int xlo0 = xq[xb];
        const int xlo1 = xq[xb + 1u];
        const int xhi0 = xq[xb + 4u];
        const int xhi1 = xq[xb + 5u];
        const vec2 dm = xd[ib];
        const float m8 = (sub == 0u) ? (-8.0 * dm.y) : 0.0;

        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            const uint bi = row_b[r] + ib;
            const float dg = unpackHalf2x16(uint(wg_d[bi])).x;
            const float du = unpackHalf2x16(uint(wu_d[bi])).x;
            const uvec2 qg = wg_q[bi * 2u + sub];
            const uvec2 qu = wu_q[bi * 2u + sub];

            const uint ug0 = qg.x;
            const uint ug1 = qg.y;
            const int sg = sdot4x8(int(ug0 & 0x0F0F0F0Fu), xlo0, 0)
                         + sdot4x8(int((ug0 >> 4u) & 0x0F0F0F0Fu), xhi0, 0)
                         + sdot4x8(int(ug1 & 0x0F0F0F0Fu), xlo1, 0)
                         + sdot4x8(int((ug1 >> 4u) & 0x0F0F0F0Fu), xhi1, 0);

            const uint uu0 = qu.x;
            const uint uu1 = qu.y;
            const int su = sdot4x8(int(uu0 & 0x0F0F0F0Fu), xlo0, 0)
                         + sdot4x8(int((uu0 >> 4u) & 0x0F0F0F0Fu), xhi0, 0)
                         + sdot4x8(int(uu1 & 0x0F0F0F0Fu), xlo1, 0)
                         + sdot4x8(int((uu1 >> 4u) & 0x0F0F0F0Fu), xhi1, 0);

            acc_g[r] = fma(dg, fma(float(sg), dm.x, m8), acc_g[r]);
            acc_u[r] = fma(du, fma(float(su), dm.x, m8), acc_u[r]);
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float g = subgroupAdd(acc_g[r]);
        const float u = subgroupAdd(acc_u[r]);
        if (subgroupElect() && row0 + r < pc.n_out) {
            y[row0 + r] = (g / (1.0 + exp(-g))) * u;
        }
    }
}
