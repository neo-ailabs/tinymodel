#version 450
// Subgroup-portable quantized GEMV with optional fused residual add (`y[r] = W[r]*x + (res ? y[r] : 0)`).
// Quantization block layouts match ggml (Copyright (c) 2023-2026 The ggml authors, MIT).
//
// DTYPE (constant_id = 1):
//   0 = Q4_0, 1 = Q4_1, 2 = Q8_0, 3 = Q5_K, 4 = Q6_K, 5 = F32
// NR (constant_id = 2): rows per subgroup (1..4).

#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint DTYPE = 0;
layout(constant_id = 2) const uint NR = 2;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer W { uint16_t w16[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) buffer Y { float y[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint add_residual;
    uint row_u16s; // row_bytes / 2
} pc;

int sbyte_lo(uint u16) { return bitfieldExtract(int(u16), 0, 8); }
int sbyte_hi(uint u16) { return bitfieldExtract(int(u16), 8, 8); }
uint ubyte_at(uint base_u16, uint byte_idx) {
    uint w = uint(w16[base_u16 + (byte_idx >> 1u)]);
    return ((byte_idx & 1u) == 0u) ? (w & 0xFFu) : (w >> 8u);
}
int sbyte_at(uint base_u16, uint byte_idx) {
    uint b = ubyte_at(base_u16, byte_idx);
    return bitfieldExtract(int(b), 0, 8);
}

void unpack_q5k_sc_m(uint sc_u16_base, uint is, out uint sc, out uint m) {
    if (is < 4u) {
        sc = ubyte_at(sc_u16_base, is) & 63u;
        m  = ubyte_at(sc_u16_base, is + 4u) & 63u;
    } else {
        uint b4 = ubyte_at(sc_u16_base, is + 4u);
        uint bm4 = ubyte_at(sc_u16_base, is - 4u);
        uint b0 = ubyte_at(sc_u16_base, is);
        sc = (b4 & 0x0Fu) | ((bm4 >> 6u) << 4u);
        m  = (b4 >> 4u)   | ((b0  >> 6u) << 4u);
    }
}

void main() {
    const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    if (row0 >= pc.n_out) return;

    const uint lane = gl_SubgroupInvocationID;
    const uint sg_size = gl_SubgroupSize;

    float acc[NR];
    uint row_b[NR];
    for (uint r = 0u; r < NR; ++r) {
        acc[r] = 0.0;
        const uint row = min(row0 + r, pc.n_out - 1u);
        row_b[r] = row * pc.row_u16s;
    }

    if (DTYPE == 0u) {
        const uint nb = pc.n_in / 32u;
        for (uint ib = lane; ib < nb; ib += sg_size) {
            const uint xb = ib * 32u;
            float sumx = 0.0;
            float xv[32];
            for (uint k = 0u; k < 32u; ++k) {
                xv[k] = x[xb + k];
                sumx += xv[k];
            }
            const float corr = -8.0 * sumx;
            for (uint r = 0u; r < NR; ++r) {
                const uint b = row_b[r] + ib * 9u;
                const float d = unpackHalf2x16(uint(w16[b])).x;
                float s = 0.0;
                for (uint j = 0u; j < 8u; ++j) {
                    const uint u = uint(w16[b + 1u + j]);
                    const uint b0 = u & 0xFFu;
                    const uint b1 = u >> 8u;
                    s = fma(float(b0 & 15u), xv[2u * j], s);
                    s = fma(float(b0 >> 4u), xv[2u * j + 16u], s);
                    s = fma(float(b1 & 15u), xv[2u * j + 1u], s);
                    s = fma(float(b1 >> 4u), xv[2u * j + 17u], s);
                }
                acc[r] = fma(d, s + corr, acc[r]);
            }
        }
    } else if (DTYPE == 1u) {
        const uint nb = pc.n_in / 32u;
        for (uint ib = lane; ib < nb; ib += sg_size) {
            const uint xb = ib * 32u;
            float sumx = 0.0;
            float xv[32];
            for (uint k = 0u; k < 32u; ++k) {
                xv[k] = x[xb + k];
                sumx += xv[k];
            }
            for (uint r = 0u; r < NR; ++r) {
                const uint b = row_b[r] + ib * 10u;
                const float d = unpackHalf2x16(uint(w16[b])).x;
                const float m = unpackHalf2x16(uint(w16[b + 1u])).x;
                float s = 0.0;
                for (uint j = 0u; j < 8u; ++j) {
                    const uint u = uint(w16[b + 2u + j]);
                    const uint b0 = u & 0xFFu;
                    const uint b1 = u >> 8u;
                    s = fma(float(b0 & 15u), xv[2u * j], s);
                    s = fma(float(b0 >> 4u), xv[2u * j + 16u], s);
                    s = fma(float(b1 & 15u), xv[2u * j + 1u], s);
                    s = fma(float(b1 >> 4u), xv[2u * j + 17u], s);
                }
                acc[r] = fma(d, s, fma(m, sumx, acc[r]));
            }
        }
    } else if (DTYPE == 2u) {
        const uint nb = pc.n_in / 32u;
        if (sg_size <= 32u) {
            for (uint ib = 0u; ib < nb; ++ib) {
                float d[NR];
                for (uint r = 0u; r < NR; ++r) {
                    d[r] = unpackHalf2x16(uint(w16[row_b[r] + ib * 17u])).x;
                }
                for (uint e = lane; e < 32u; e += sg_size) {
                    const float xv = x[ib * 32u + e];
                    for (uint r = 0u; r < NR; ++r) {
                        const int q = sbyte_at(row_b[r] + ib * 17u + 1u, e);
                        acc[r] = fma(d[r] * float(q), xv, acc[r]);
                    }
                }
            }
        } else {
            const uint sub_blk = lane >> 5u;
            const uint e = lane & 31u;
            const uint step_blk = sg_size >> 5u;
            for (uint ib = sub_blk; ib < nb; ib += step_blk) {
                const float xv = x[ib * 32u + e];
                for (uint r = 0u; r < NR; ++r) {
                    const uint b = row_b[r] + ib * 17u;
                    const float d = unpackHalf2x16(uint(w16[b])).x;
                    acc[r] = fma(d * float(sbyte_at(b + 1u, e)), xv, acc[r]);
                }
            }
        }
    } else if (DTYPE == 3u) {
        const uint nb = pc.n_in / 256u;
        for (uint ib = 0u; ib < nb; ++ib) {
            float d[NR];
            float dmin[NR];
            for (uint r = 0u; r < NR; ++r) {
                const uint b = row_b[r] + ib * 88u;
                d[r]    = unpackHalf2x16(uint(w16[b])).x;
                dmin[r] = unpackHalf2x16(uint(w16[b + 1u])).x;
            }
            for (uint l = lane; l < 32u; l += sg_size) {
                uint qhv[NR];
                for (uint r = 0u; r < NR; ++r) {
                    qhv[r] = ubyte_at(row_b[r] + ib * 88u + 8u, l);
                }
                for (uint chunk = 0u; chunk < 4u; ++chunk) {
                    const float x_lo = x[ib * 256u + chunk * 64u + l];
                    const float x_hi = x[ib * 256u + chunk * 64u + 32u + l];
                    for (uint r = 0u; r < NR; ++r) {
                        const uint b = row_b[r] + ib * 88u;
                        uint sc0, m0, sc1, m1;
                        unpack_q5k_sc_m(b + 2u, 2u * chunk,      sc0, m0);
                        unpack_q5k_sc_m(b + 2u, 2u * chunk + 1u, sc1, m1);
                        const uint ql = ubyte_at(b + 24u, chunk * 32u + l);
                        const float q_lo = float((ql & 0x0Fu) | (((qhv[r] >> (2u * chunk)) & 1u) << 4u));
                        const float q_hi = float((ql >> 4u)   | (((qhv[r] >> (2u * chunk + 1u)) & 1u) << 4u));
                        const float w_lo = fma(d[r] * float(sc0), q_lo, -dmin[r] * float(m0));
                        const float w_hi = fma(d[r] * float(sc1), q_hi, -dmin[r] * float(m1));
                        acc[r] = fma(w_lo, x_lo, fma(w_hi, x_hi, acc[r]));
                    }
                }
            }
        }
    } else if (DTYPE == 4u) {
        const uint nb = pc.n_in / 256u;
        for (uint ib = 0u; ib < nb; ++ib) {
            float d[NR];
            for (uint r = 0u; r < NR; ++r) {
                d[r] = unpackHalf2x16(uint(w16[row_b[r] + ib * 105u + 104u])).x;
            }
            for (uint l = lane; l < 32u; l += sg_size) {
                const uint is = l >> 4u;
                for (uint half_idx = 0u; half_idx < 2u; ++half_idx) {
                    const uint xh = ib * 256u + half_idx * 128u + l;
                    const float xa = x[xh];
                    const float xb = x[xh + 32u];
                    const float xc = x[xh + 64u];
                    const float xd = x[xh + 96u];
                    for (uint r = 0u; r < NR; ++r) {
                        const uint b = row_b[r] + ib * 105u;
                        const uint ql0 = ubyte_at(b + half_idx * 32u, l);
                        const uint ql1 = ubyte_at(b + half_idx * 32u, l + 32u);
                        const uint qhv = ubyte_at(b + 64u + half_idx * 16u, l);
                        const uint sc_b = b + 96u + half_idx * 4u;
                        const int qa = int((ql0 & 0x0Fu) | ((qhv & 3u) << 4u)) - 32;
                        const int qb = int((ql1 & 0x0Fu) | (((qhv >> 2u) & 3u) << 4u)) - 32;
                        const int qc = int((ql0 >> 4u)   | (((qhv >> 4u) & 3u) << 4u)) - 32;
                        const int qd = int((ql1 >> 4u)   | (((qhv >> 6u) & 3u) << 4u)) - 32;
                        float s = 0.0;
                        s = fma(float(sbyte_at(sc_b, is))      * float(qa), xa, s);
                        s = fma(float(sbyte_at(sc_b, is + 2u)) * float(qb), xb, s);
                        s = fma(float(sbyte_at(sc_b, is + 4u)) * float(qc), xc, s);
                        s = fma(float(sbyte_at(sc_b, is + 6u)) * float(qd), xd, s);
                        acc[r] = fma(d[r], s, acc[r]);
                    }
                }
            }
        }
    } else {
        for (uint k = lane; k < pc.n_in; k += sg_size) {
            const float xv = x[k];
            for (uint r = 0u; r < NR; ++r) {
                const uint idx = row_b[r] + 2u * k;
                const uint bits = uint(w16[idx]) | (uint(w16[idx + 1u]) << 16u);
                acc[r] = fma(uintBitsToFloat(bits), xv, acc[r]);
            }
        }
    }

    for (uint r = 0u; r < NR; ++r) {
        const float out_v = subgroupAdd(acc[r]);
        if (subgroupElect() && row0 + r < pc.n_out) {
            const uint yi = row0 + r;
            y[yi] = (pc.add_residual != 0u) ? (y[yi] + out_v) : out_v;
        }
    }
}
