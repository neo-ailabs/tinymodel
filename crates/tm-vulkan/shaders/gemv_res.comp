#version 450
// Subgroup-portable quantized GEMV with optional fused residual add (`y[r] = W[r]*x + (res ? y[r] : 0)`).
// Quantization block layouts match ggml (Copyright (c) 2023-2026 The ggml authors, MIT).
//
// DTYPE (constant_id = 1):
//   0 = Q4_0, 1 = Q4_1, 2 = Q8_0, 3 = Q5_K, 4 = Q6_K, 5 = F32
// NR (constant_id = 2): rows per subgroup (1..4).

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint DTYPE = 0;
layout(constant_id = 2) const uint NR = 2;
layout(constant_id = 3) const uint M = 1;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer W   { uint16_t w16[]; };
layout(std430, binding = 0) readonly buffer W32 { uint w32[]; };
layout(std430, binding = 1) readonly buffer X   { float x[]; };
layout(std430, binding = 1) readonly buffer X4  { vec4 x4[]; };
layout(std430, binding = 2) buffer Y            { float y[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint add_residual;
    uint row_u16s; // row_bytes / 2
} pc;

int sbyte_lo(uint u16) { return bitfieldExtract(int(u16), 0, 8); }
int sbyte_hi(uint u16) { return bitfieldExtract(int(u16), 8, 8); }
uint ubyte_at(uint base_u16, uint byte_idx) {
    uint w = uint(w16[base_u16 + (byte_idx >> 1u)]);
    return ((byte_idx & 1u) == 0u) ? (w & 0xFFu) : (w >> 8u);
}
int sbyte_at(uint base_u16, uint byte_idx) {
    uint b = ubyte_at(base_u16, byte_idx);
    return bitfieldExtract(int(b), 0, 8);
}

void unpack_q5k_sc_m(uint sc_u16_base, uint is, out uint sc, out uint m) {
    if (is < 4u) {
        sc = ubyte_at(sc_u16_base, is) & 63u;
        m  = ubyte_at(sc_u16_base, is + 4u) & 63u;
    } else {
        uint b4 = ubyte_at(sc_u16_base, is + 4u);
        uint bm4 = ubyte_at(sc_u16_base, is - 4u);
        uint b0 = ubyte_at(sc_u16_base, is);
        sc = (b4 & 0x0Fu) | ((bm4 >> 6u) << 4u);
        m  = (b4 >> 4u)   | ((b0  >> 6u) << 4u);
    }
}

void main() {
    const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    if (row0 >= pc.n_out) return;

    const uint lane = gl_SubgroupInvocationID;
    const uint sg_size = gl_SubgroupSize;

    if (M > 1u) {
        const uint n_tok = pc.add_residual >> 8u;
        const uint do_res = pc.add_residual & 1u;
        const uint x4_stride = pc.n_in >> 2u;
        float b_acc[M][NR];
        uint b_row[NR];
        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            const uint row = min(row0 + r, pc.n_out - 1u);
            b_row[r] = row * pc.row_u16s;
            [[unroll]] for (uint t = 0u; t < M; ++t) {
                b_acc[t][r] = 0.0;
            }
        }

        if (DTYPE == 0u) {
            const uint nb = pc.n_in / 32u;
            const uint sub = lane & 3u;
            const uint blk_step = sg_size >> 2u;
            for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
                float d_arr[NR];
                vec4 qlo_arr[NR];
                vec4 qhi_arr[NR];
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b = b_row[r] + ib * 9u;
                    d_arr[r] = unpackHalf2x16(uint(w16[b])).x;
                    const uint u = uint(w16[b + 1u + 2u * sub]) | (uint(w16[b + 2u + 2u * sub]) << 16u);
                    qlo_arr[r] = vec4(u & 15u, (u >> 8u) & 15u, (u >> 16u) & 15u, (u >> 24u) & 15u) - 8.0;
                    qhi_arr[r] = vec4((u >> 4u) & 15u, (u >> 12u) & 15u, (u >> 20u) & 15u, u >> 28u) - 8.0;
                }
                [[unroll]] for (uint t = 0u; t < M; ++t) {
                    if (t < n_tok) {
                        const uint xb = t * x4_stride + ib * 8u + sub;
                        const vec4 xlo = x4[xb];
                        const vec4 xhi = x4[xb + 4u];
                        [[unroll]] for (uint r = 0u; r < NR; ++r) {
                            const float s = dot(qlo_arr[r], xlo) + dot(qhi_arr[r], xhi);
                            b_acc[t][r] = fma(d_arr[r], s, b_acc[t][r]);
                        }
                    }
                }
            }
        } else if (DTYPE == 1u) {
            const uint nb = pc.n_in / 32u;
            const uint sub = lane & 3u;
            const uint blk_step = sg_size >> 2u;
            for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
                float d_arr[NR];
                float m_arr[NR];
                vec4 qlo_arr[NR];
                vec4 qhi_arr[NR];
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b = b_row[r] + ib * 10u;
                    d_arr[r] = unpackHalf2x16(uint(w16[b])).x;
                    m_arr[r] = unpackHalf2x16(uint(w16[b + 1u])).x;
                    const uint u = uint(w16[b + 2u + 2u * sub]) | (uint(w16[b + 3u + 2u * sub]) << 16u);
                    qlo_arr[r] = vec4(u & 15u, (u >> 8u) & 15u, (u >> 16u) & 15u, (u >> 24u) & 15u);
                    qhi_arr[r] = vec4((u >> 4u) & 15u, (u >> 12u) & 15u, (u >> 20u) & 15u, u >> 28u);
                }
                [[unroll]] for (uint t = 0u; t < M; ++t) {
                    if (t < n_tok) {
                        const uint xb = t * x4_stride + ib * 8u + sub;
                        const vec4 xlo = x4[xb];
                        const vec4 xhi = x4[xb + 4u];
                        const float sumx8 = (xlo.x + xlo.y + xlo.z + xlo.w) + (xhi.x + xhi.y + xhi.z + xhi.w);
                        [[unroll]] for (uint r = 0u; r < NR; ++r) {
                            const float s = dot(qlo_arr[r], xlo) + dot(qhi_arr[r], xhi);
                            b_acc[t][r] = fma(d_arr[r], s, fma(m_arr[r], sumx8, b_acc[t][r]));
                        }
                    }
                }
            }
        } else if (DTYPE == 2u) {
            const uint nb = pc.n_in / 32u;
            const uint sub_blk = lane >> 3u;
            const uint sub_lane = lane & 7u;
            const uint step_blk = sg_size >> 3u;
            const uint q_u16_off = 1u + (sub_lane << 1u);
            for (uint ib = sub_blk; ib < nb; ib += step_blk) {
                const uint blk_u16 = ib * 17u;
                float d_arr[NR];
                vec4 q4_arr[NR];
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b = b_row[r] + blk_u16;
                    const uint dw = w32[b >> 1u];
                    d_arr[r] = ((b & 1u) == 0u) ? unpackHalf2x16(dw).x : unpackHalf2x16(dw).y;
                    const uint q = b + q_u16_off;
                    const uint q32 = ((q & 1u) == 0u)
                        ? w32[q >> 1u]
                        : ((w32[q >> 1u] >> 16u) | (w32[(q >> 1u) + 1u] << 16u));
                    q4_arr[r] = vec4(
                        float(bitfieldExtract(int(q32), 0, 8)),
                        float(bitfieldExtract(int(q32), 8, 8)),
                        float(bitfieldExtract(int(q32), 16, 8)),
                        float(bitfieldExtract(int(q32), 24, 8))
                    );
                }
                [[unroll]] for (uint t = 0u; t < M; ++t) {
                    if (t < n_tok) {
                        const vec4 xv = x4[t * x4_stride + ib * 8u + sub_lane];
                        [[unroll]] for (uint r = 0u; r < NR; ++r) {
                            b_acc[t][r] = fma(d_arr[r], dot(q4_arr[r], xv), b_acc[t][r]);
                        }
                    }
                }
            }
        } else {
            for (uint k = lane; k < pc.n_in; k += sg_size) {
                float w_arr[NR];
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    w_arr[r] = uintBitsToFloat(w32[(b_row[r] >> 1u) + k]);
                }
                [[unroll]] for (uint t = 0u; t < M; ++t) {
                    if (t < n_tok) {
                        const float xv = x[t * pc.n_in + k];
                        [[unroll]] for (uint r = 0u; r < NR; ++r) {
                            b_acc[t][r] = fma(w_arr[r], xv, b_acc[t][r]);
                        }
                    }
                }
            }
        }

        [[unroll]] for (uint t = 0u; t < M; ++t) {
            if (t < n_tok) {
                const uint yb = t * pc.n_out;
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const float out_v = subgroupAdd(b_acc[t][r]);
                    if (subgroupElect() && row0 + r < pc.n_out) {
                        const uint yi = yb + row0 + r;
                        y[yi] = (do_res != 0u) ? (y[yi] + out_v) : out_v;
                    }
                }
            }
        }
        return;
    }

    const uint tok = gl_WorkGroupID.y;
    const uint x_off = tok * pc.n_in;
    const uint x4_off = x_off >> 2u;
    const uint y_off = tok * pc.n_out;

    float acc[NR];
    uint row_b[NR];
    for (uint r = 0u; r < NR; ++r) {
        acc[r] = 0.0;
        const uint row = min(row0 + r, pc.n_out - 1u);
        row_b[r] = row * pc.row_u16s;
    }

    if (DTYPE == 0u) {
        const uint nb = pc.n_in / 32u;
        const uint sub = lane & 3u;
        const uint blk_step = sg_size >> 2u;
        for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
            const vec4 xlo = x4[x4_off + ib * 8u + sub];
            const vec4 xhi = x4[x4_off + ib * 8u + 4u + sub];
            for (uint r = 0u; r < NR; ++r) {
                const uint b = row_b[r] + ib * 9u;
                const float d = unpackHalf2x16(uint(w16[b])).x;
                const uint u = uint(w16[b + 1u + 2u * sub]) | (uint(w16[b + 2u + 2u * sub]) << 16u);
                const float s = dot(vec4(u & 15u, (u >> 8u) & 15u, (u >> 16u) & 15u, (u >> 24u) & 15u) - 8.0, xlo)
                              + dot(vec4((u >> 4u) & 15u, (u >> 12u) & 15u, (u >> 20u) & 15u, u >> 28u) - 8.0, xhi);
                acc[r] = fma(d, s, acc[r]);
            }
        }
    } else if (DTYPE == 1u) {
        const uint nb = pc.n_in / 32u;
        const uint sub = lane & 3u;
        const uint blk_step = sg_size >> 2u;
        for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
            const vec4 xlo = x4[x4_off + ib * 8u + sub];
            const vec4 xhi = x4[x4_off + ib * 8u + 4u + sub];
            const float sumx8 = (xlo.x + xlo.y + xlo.z + xlo.w) + (xhi.x + xhi.y + xhi.z + xhi.w);
            for (uint r = 0u; r < NR; ++r) {
                const uint b = row_b[r] + ib * 10u;
                const float d = unpackHalf2x16(uint(w16[b])).x;
                const float m = unpackHalf2x16(uint(w16[b + 1u])).x;
                const uint u = uint(w16[b + 2u + 2u * sub]) | (uint(w16[b + 3u + 2u * sub]) << 16u);
                const float s = dot(vec4(u & 15u, (u >> 8u) & 15u, (u >> 16u) & 15u, (u >> 24u) & 15u), xlo)
                              + dot(vec4((u >> 4u) & 15u, (u >> 12u) & 15u, (u >> 20u) & 15u, u >> 28u), xhi);
                acc[r] = fma(d, s, fma(m, sumx8, acc[r]));
            }
        }
    } else if (DTYPE == 2u) {
        // Coalesced 8-lane Q8_0 GEMV (128-bit `vec4` activation loads + 32-bit `w32` weight loads;
        // 4 blocks/iter on warp32, 8 on wave64).
        const uint nb = pc.n_in / 32u;
        const uint sub_blk = lane >> 3u;
        const uint sub_lane = lane & 7u;
        const uint step_blk = sg_size >> 3u;
        const uint q_u16_off = 1u + (sub_lane << 1u);

        for (uint ib = sub_blk; ib < nb; ib += step_blk) {
            const vec4 xv = x4[x4_off + ib * 8u + sub_lane];
            const uint blk_u16 = ib * 17u;
            for (uint r = 0u; r < NR; ++r) {
                const uint b = row_b[r] + blk_u16;
                const uint dw = w32[b >> 1u];
                const float d = ((b & 1u) == 0u) ? unpackHalf2x16(dw).x : unpackHalf2x16(dw).y;
                const uint q = b + q_u16_off;
                const uint q32 = ((q & 1u) == 0u)
                    ? w32[q >> 1u]
                    : ((w32[q >> 1u] >> 16u) | (w32[(q >> 1u) + 1u] << 16u));
                const vec4 q4 = vec4(
                    float(bitfieldExtract(int(q32), 0, 8)),
                    float(bitfieldExtract(int(q32), 8, 8)),
                    float(bitfieldExtract(int(q32), 16, 8)),
                    float(bitfieldExtract(int(q32), 24, 8))
                );
                acc[r] = fma(d, dot(q4, xv), acc[r]);
            }
        }
    } else if (DTYPE == 3u) {
        // Coalesced 32-bit/128-bit Q5_K GEMV: each superblock (256 elems = 176B = 44 u32) is
        // split into 8 groups (`l4 = 0..7`, 4 contiguous elements each). Across `nb * 8` groups,
        // wave32 processes 4 superblocks simultaneously with zero unaligned byte loads!
        const uint nb = pc.n_in / 256u;
        const uint total_groups = nb * 8u;
        for (uint idx = lane; idx < total_groups; idx += sg_size) {
            const uint ib = idx >> 3u;
            const uint l4 = idx & 7u;
            vec4 x_lo[4];
            vec4 x_hi[4];
            for (uint chunk = 0u; chunk < 4u; ++chunk) {
                const uint x4_base = x4_off + ib * 64u + chunk * 16u + l4;
                x_lo[chunk] = x4[x4_base];
                x_hi[chunk] = x4[x4_base + 8u];
            }
            for (uint r = 0u; r < NR; ++r) {
                const uint b32 = (row_b[r] >> 1u) + ib * 44u;
                const vec2 dm = unpackHalf2x16(w32[b32]);
                const uint s0 = w32[b32 + 1u];
                const uint s1 = w32[b32 + 2u];
                const uint s2 = w32[b32 + 3u];
                const uint qh4 = w32[b32 + 4u + l4];
                const uvec4 qh_bytes = uvec4(
                    qh4 & 0xFFu,
                    (qh4 >> 8u) & 0xFFu,
                    (qh4 >> 16u) & 0xFFu,
                    qh4 >> 24u
                );

                for (uint chunk = 0u; chunk < 4u; ++chunk) {
                    uint sc0, m0, sc1, m1;
                    if (chunk < 2u) {
                        const uint sh0 = (2u * chunk) * 8u;
                        const uint sh1 = (2u * chunk + 1u) * 8u;
                        sc0 = (s0 >> sh0) & 63u;
                        m0  = (s1 >> sh0) & 63u;
                        sc1 = (s0 >> sh1) & 63u;
                        m1  = (s1 >> sh1) & 63u;
                    } else {
                        const uint k0 = (2u * chunk - 4u) * 8u;
                        const uint k1 = (2u * chunk - 3u) * 8u;
                        const uint b4_0  = (s2 >> k0) & 0xFFu;
                        const uint bm4_0 = (s0 >> k0) & 0xFFu;
                        const uint b0_0  = (s1 >> k0) & 0xFFu;
                        sc0 = (b4_0 & 0x0Fu) | ((bm4_0 >> 6u) << 4u);
                        m0  = (b4_0 >> 4u)   | ((b0_0  >> 6u) << 4u);

                        const uint b4_1  = (s2 >> k1) & 0xFFu;
                        const uint bm4_1 = (s0 >> k1) & 0xFFu;
                        const uint b0_1  = (s1 >> k1) & 0xFFu;
                        sc1 = (b4_1 & 0x0Fu) | ((bm4_1 >> 6u) << 4u);
                        m1  = (b4_1 >> 4u)   | ((b0_1  >> 6u) << 4u);
                    }

                    const uint ql4 = w32[b32 + 12u + chunk * 8u + l4];
                    const uvec4 ql_bytes = uvec4(
                        ql4 & 0xFFu,
                        (ql4 >> 8u) & 0xFFu,
                        (ql4 >> 16u) & 0xFFu,
                        ql4 >> 24u
                    );
                    const vec4 q_lo = vec4((ql_bytes & 15u) | (((qh_bytes >> (2u * chunk)) & 1u) << 4u));
                    const vec4 q_hi = vec4((ql_bytes >> 4u) | (((qh_bytes >> (2u * chunk + 1u)) & 1u) << 4u));
                    const vec4 w_lo = fma(vec4(dm.x * float(sc0)), q_lo, vec4(-dm.y * float(m0)));
                    const vec4 w_hi = fma(vec4(dm.x * float(sc1)), q_hi, vec4(-dm.y * float(m1)));
                    acc[r] += dot(w_lo, x_lo[chunk]) + dot(w_hi, x_hi[chunk]);
                }
            }
        }
    } else if (DTYPE == 4u) {
        // Coalesced 16-bit paired Q6_K GEMV: each superblock (256 elems = 105 u16) is split into
        // 16 pairs (`l2 = 0..15`, 2 contiguous elements sharing scale index `is = l2 >> 3`).
        // Wave32 processes 2 superblocks per step with aligned `w16` loads!
        const uint nb = pc.n_in / 256u;
        const uint total_pairs = nb * 16u;
        for (uint idx = lane; idx < total_pairs; idx += sg_size) {
            const uint ib = idx >> 4u;
            const uint l2 = idx & 15u;
            const uint is = l2 >> 3u;
            for (uint half_idx = 0u; half_idx < 2u; ++half_idx) {
                const uint xh = x_off + ib * 256u + half_idx * 128u + l2 * 2u;
                const vec2 xa = vec2(x[xh],        x[xh + 1u]);
                const vec2 xb = vec2(x[xh + 32u],  x[xh + 33u]);
                const vec2 xc = vec2(x[xh + 64u],  x[xh + 65u]);
                const vec2 xd = vec2(x[xh + 96u],  x[xh + 97u]);
                for (uint r = 0u; r < NR; ++r) {
                    const uint b = row_b[r] + ib * 105u;
                    const float d = unpackHalf2x16(uint(w16[b + 104u])).x;
                    const uint ql0_u = uint(w16[b + half_idx * 32u + l2]);
                    const uint ql1_u = uint(w16[b + half_idx * 32u + 16u + l2]);
                    const uint qh_u  = uint(w16[b + 64u + half_idx * 16u + l2]);
                    const uint sc_b  = b + 96u + half_idx * 4u;

                    const uvec2 ql0 = uvec2(ql0_u & 0xFFu, ql0_u >> 8u);
                    const uvec2 ql1 = uvec2(ql1_u & 0xFFu, ql1_u >> 8u);
                    const uvec2 qhv = uvec2(qh_u  & 0xFFu, qh_u  >> 8u);

                    const vec2 qa = vec2(ivec2((ql0 & 15u) | ((qhv & 3u) << 4u)) - 32);
                    const vec2 qb = vec2(ivec2((ql1 & 15u) | (((qhv >> 2u) & 3u) << 4u)) - 32);
                    const vec2 qc = vec2(ivec2((ql0 >> 4u) | (((qhv >> 4u) & 3u) << 4u)) - 32);
                    const vec2 qd = vec2(ivec2((ql1 >> 4u) | (((qhv >> 6u) & 3u) << 4u)) - 32);

                    float s = 0.0;
                    s = fma(float(sbyte_at(sc_b, is))      * dot(qa, xa), 1.0, s);
                    s = fma(float(sbyte_at(sc_b, is + 2u)) * dot(qb, xb), 1.0, s);
                    s = fma(float(sbyte_at(sc_b, is + 4u)) * dot(qc, xc), 1.0, s);
                    s = fma(float(sbyte_at(sc_b, is + 6u)) * dot(qd, xd), 1.0, s);
                    acc[r] = fma(d, s, acc[r]);
                }
            }
        }
    } else {
        // Coalesced 32-bit F32 GEMV (`1` 32-bit `w32` load per element instead of split `u16` loads).
        for (uint k = lane; k < pc.n_in; k += sg_size) {
            const float xv = x[x_off + k];
            for (uint r = 0u; r < NR; ++r) {
                const uint idx32 = (row_b[r] >> 1u) + k;
                acc[r] = fma(uintBitsToFloat(w32[idx32]), xv, acc[r]);
            }
        }
    }

    for (uint r = 0u; r < NR; ++r) {
        const float out_v = subgroupAdd(acc[r]);
        if (subgroupElect() && row0 + r < pc.n_out) {
            const uint yi = y_off + row0 + r;
            y[yi] = (pc.add_residual != 0u) ? (y[yi] + out_v) : out_v;
        }
    }
}
