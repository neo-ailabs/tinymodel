#version 450
// Elementwise SwiGLU: gate[i] = silu(gate[i]) * up[i] (grid-strided so `gx <= 65535` on all GPUs).

layout(constant_id = 0) const uint WG = 256;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) buffer Gate { float gate[]; };
layout(std430, binding = 1) readonly buffer Up { float up[]; };

layout(push_constant) uniform PC {
    uint n;
} pc;

void main() {
    const uint stride = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) {
        const float g = gate[i];
        gate[i] = (g / (1.0 + exp(-g))) * up[i];
    }
}
