#version 450
// Subgroup-portable AoS INT8 DP4A (`OpSDotKHR`) quantized GEMV with optional fused residual add
// and register-batched multi-token (`M = 1, 4, 8`) execution (`0-ULP` bit-exact across `M`).
//
// DTYPE (constant_id = 1):
//   0 = Q4_0, 1 = Q4_1, 2 = Q8_0, 3 = Q5_K
// NR (constant_id = 2): rows per subgroup (1..4)
// M  (constant_id = 3): 1 (decode / 2D `gl_WorkGroupID.y = tok`) or 4 / 8 (single-read multi-token)

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6018, 6019], id = 4450)
int sdot4x8(int a, int b, spirv_literal int packed_fmt);

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint DTYPE = 0;
layout(constant_id = 2) const uint NR = 2;
layout(constant_id = 3) const uint M = 1;
layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer W   { uint16_t w16[]; };
layout(std430, binding = 0) readonly buffer W32 { uint w32[]; };
layout(std430, binding = 1) readonly buffer XQ  { int xq[]; };
layout(std430, binding = 2) readonly buffer XD  { vec2 xd[]; };
layout(std430, binding = 3) buffer Y            { float y[]; };

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint add_residual;
    uint row_u16s;
} pc;

void main() {
    const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * NR;
    if (row0 >= pc.n_out) return;

    const uint lane = gl_SubgroupInvocationID;
    const uint sg_size = gl_SubgroupSize;
    const uint nb = pc.n_in >> 5u;

    if (M > 1u) {
        const uint n_tok = pc.add_residual >> 8u;
        const uint do_res = pc.add_residual & 1u;
        float b_acc[M][NR];
        uint b_row[NR];
        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            const uint row = min(row0 + r, pc.n_out - 1u);
            b_row[r] = row * pc.row_u16s;
            [[unroll]] for (uint t = 0u; t < M; ++t) {
                b_acc[t][r] = 0.0;
            }
        }

        if (DTYPE == 0u) {
            const uint sub = lane & 3u;
            const uint blk_step = sg_size >> 2u;
            for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
                float d_arr[NR];
                int qlo_arr[NR];
                int qhi_arr[NR];
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b = b_row[r] + ib * 9u;
                    d_arr[r] = unpackHalf2x16(uint(w16[b])).x;
                    const uint u = uint(w16[b + 1u + 2u * sub]) | (uint(w16[b + 2u + 2u * sub]) << 16u);
                    qlo_arr[r] = int(u & 0x0F0F0F0Fu);
                    qhi_arr[r] = int((u >> 4u) & 0x0F0F0F0Fu);
                }
                [[unroll]] for (uint t = 0u; t < M; ++t) {
                    if (t < n_tok) {
                        const uint gblk = t * nb + ib;
                        const int xlo = xq[gblk * 8u + sub];
                        const int xhi = xq[gblk * 8u + 4u + sub];
                        const vec2 dm = xd[gblk];
                        const float m8 = (sub == 0u) ? (-8.0 * dm.y) : 0.0;
                        [[unroll]] for (uint r = 0u; r < NR; ++r) {
                            const int s = sdot4x8(qlo_arr[r], xlo, 0) + sdot4x8(qhi_arr[r], xhi, 0);
                            b_acc[t][r] = fma(d_arr[r], fma(float(s), dm.x, m8), b_acc[t][r]);
                        }
                    }
                }
            }
        } else if (DTYPE == 1u) {
            const uint sub = lane & 3u;
            const uint blk_step = sg_size >> 2u;
            for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
                vec2 wdm_arr[NR];
                int qlo_arr[NR];
                int qhi_arr[NR];
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b32 = (b_row[r] >> 1u) + ib * 5u;
                    wdm_arr[r] = unpackHalf2x16(w32[b32]);
                    const uint u = w32[b32 + 1u + sub];
                    qlo_arr[r] = int(u & 0x0F0F0F0Fu);
                    qhi_arr[r] = int((u >> 4u) & 0x0F0F0F0Fu);
                }
                [[unroll]] for (uint t = 0u; t < M; ++t) {
                    if (t < n_tok) {
                        const uint gblk = t * nb + ib;
                        const int xlo = xq[gblk * 8u + sub];
                        const int xhi = xq[gblk * 8u + 4u + sub];
                        const vec2 dm = xd[gblk];
                        [[unroll]] for (uint r = 0u; r < NR; ++r) {
                            const int s = sdot4x8(qlo_arr[r], xlo, 0) + sdot4x8(qhi_arr[r], xhi, 0);
                            const float base = (sub == 0u) ? fma(wdm_arr[r].y, dm.y, b_acc[t][r]) : b_acc[t][r];
                            b_acc[t][r] = fma(wdm_arr[r].x * dm.x, float(s), base);
                        }
                    }
                }
            }
        } else if (DTYPE == 2u) {
            const uint sub_blk = lane >> 3u;
            const uint sub_lane = lane & 7u;
            const uint step_blk = sg_size >> 3u;
            const uint q_u16_off = 1u + (sub_lane << 1u);
            for (uint ib = sub_blk; ib < nb; ib += step_blk) {
                const uint blk_u16 = ib * 17u;
                float d_arr[NR];
                int q32_arr[NR];
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b = b_row[r] + blk_u16;
                    const uint dw = w32[b >> 1u];
                    d_arr[r] = ((b & 1u) == 0u) ? unpackHalf2x16(dw).x : unpackHalf2x16(dw).y;
                    const uint q = b + q_u16_off;
                    const uint q32 = ((q & 1u) == 0u)
                        ? w32[q >> 1u]
                        : ((w32[q >> 1u] >> 16u) | (w32[(q >> 1u) + 1u] << 16u));
                    q32_arr[r] = int(q32);
                }
                [[unroll]] for (uint t = 0u; t < M; ++t) {
                    if (t < n_tok) {
                        const uint gblk = t * nb + ib;
                        const int xqv = xq[gblk * 8u + sub_lane];
                        const float dx = xd[gblk].x;
                        [[unroll]] for (uint r = 0u; r < NR; ++r) {
                            b_acc[t][r] = fma(d_arr[r] * dx, float(sdot4x8(q32_arr[r], xqv, 0)), b_acc[t][r]);
                        }
                    }
                }
            }
        }

        [[unroll]] for (uint t = 0u; t < M; ++t) {
            if (t < n_tok) {
                const uint yb = t * pc.n_out;
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const float out_v = subgroupAdd(b_acc[t][r]);
                    if (subgroupElect() && row0 + r < pc.n_out) {
                        const uint yi = yb + row0 + r;
                        y[yi] = (do_res != 0u) ? (y[yi] + out_v) : out_v;
                    }
                }
            }
        }
        return;
    }

    const uint tok = gl_WorkGroupID.y;
    const uint x_blk_off = tok * nb;
    const uint y_off = tok * pc.n_out;

    float acc[NR];
    uint row_b[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        acc[r] = 0.0;
        const uint row = min(row0 + r, pc.n_out - 1u);
        row_b[r] = row * pc.row_u16s;
    }

    if (DTYPE == 0u) {
        const uint sub = lane & 3u;
        const uint blk_step = sg_size >> 2u;
        if ((nb & 1u) == 0u && (pc.row_u16s & 1u) == 0u && tok == 0u) {
            const uint np = nb >> 1u;
            for (uint ip = (lane >> 2u); ip < np; ip += blk_step) {
                const uint ib0 = ip << 1u;
                const uint ib1 = ib0 + 1u;
                const int xlo0 = xq[ib0 * 8u + sub];
                const int xhi0 = xq[ib0 * 8u + 4u + sub];
                const int xlo1 = xq[ib1 * 8u + sub];
                const int xhi1 = xq[ib1 * 8u + 4u + sub];
                const vec2 dm0 = xd[ib0];
                const vec2 dm1 = xd[ib1];
                const float m8_0 = (sub == 0u) ? (-8.0 * dm0.y) : 0.0;
                const float m8_1 = (sub == 0u) ? (-8.0 * dm1.y) : 0.0;
                const uint ip9 = ip * 9u;
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b32 = (row_b[r] >> 1u) + ip9;
                    const float d0 = unpackHalf2x16(w32[b32]).x;
                    const uint u0 = (w32[b32 + sub] >> 16u) | (w32[b32 + sub + 1u] << 16u);
                    const float d1 = unpackHalf2x16(w32[b32 + 4u]).y;
                    const uint u1 = w32[b32 + 5u + sub];
                    const int s0 = sdot4x8(int(u0 & 0x0F0F0F0Fu), xlo0, 0)
                                 + sdot4x8(int((u0 >> 4u) & 0x0F0F0F0Fu), xhi0, 0);
                    const int s1 = sdot4x8(int(u1 & 0x0F0F0F0Fu), xlo1, 0)
                                 + sdot4x8(int((u1 >> 4u) & 0x0F0F0F0Fu), xhi1, 0);
                    acc[r] = fma(d1, fma(float(s1), dm1.x, m8_1),
                             fma(d0, fma(float(s0), dm0.x, m8_0), acc[r]));
                }
            }
        } else {
            for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
                const uint gblk = x_blk_off + ib;
                const int xlo = xq[gblk * 8u + sub];
                const int xhi = xq[gblk * 8u + 4u + sub];
                const vec2 dm = xd[gblk];
                const float m8 = (sub == 0u) ? (-8.0 * dm.y) : 0.0;
                [[unroll]] for (uint r = 0u; r < NR; ++r) {
                    const uint b = row_b[r] + ib * 9u;
                    const float d = unpackHalf2x16(uint(w16[b])).x;
                    const uint u = uint(w16[b + 1u + 2u * sub]) | (uint(w16[b + 2u + 2u * sub]) << 16u);
                    const int s = sdot4x8(int(u & 0x0F0F0F0Fu), xlo, 0)
                                + sdot4x8(int((u >> 4u) & 0x0F0F0F0Fu), xhi, 0);
                    acc[r] = fma(d, fma(float(s), dm.x, m8), acc[r]);
                }
            }
        }
    } else if (DTYPE == 1u) {
        const uint sub = lane & 3u;
        const uint blk_step = sg_size >> 2u;
        for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
            const uint gblk = x_blk_off + ib;
            const int xlo = xq[gblk * 8u + sub];
            const int xhi = xq[gblk * 8u + 4u + sub];
            const vec2 dm = xd[gblk];
            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                const uint b32 = (row_b[r] >> 1u) + ib * 5u;
                const vec2 wdm = unpackHalf2x16(w32[b32]);
                const uint u = w32[b32 + 1u + sub];
                const int s = sdot4x8(int(u & 0x0F0F0F0Fu), xlo, 0)
                            + sdot4x8(int((u >> 4u) & 0x0F0F0F0Fu), xhi, 0);
                const float base = (sub == 0u) ? fma(wdm.y, dm.y, acc[r]) : acc[r];
                acc[r] = fma(wdm.x * dm.x, float(s), base);
            }
        }
    } else if (DTYPE == 2u) {
        const uint sub_blk = lane >> 3u;
        const uint sub_lane = lane & 7u;
        const uint step_blk = sg_size >> 3u;
        const uint q_u16_off = 1u + (sub_lane << 1u);
        for (uint ib = sub_blk; ib < nb; ib += step_blk) {
            const uint gblk = x_blk_off + ib;
            const int xqv = xq[gblk * 8u + sub_lane];
            const float dx = xd[gblk].x;
            const uint blk_u16 = ib * 17u;
            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                const uint b = row_b[r] + blk_u16;
                const uint dw = w32[b >> 1u];
                const float d = ((b & 1u) == 0u) ? unpackHalf2x16(dw).x : unpackHalf2x16(dw).y;
                const uint q = b + q_u16_off;
                const uint q32 = ((q & 1u) == 0u)
                    ? w32[q >> 1u]
                    : ((w32[q >> 1u] >> 16u) | (w32[(q >> 1u) + 1u] << 16u));
                acc[r] = fma(d * dx, float(sdot4x8(int(q32), xqv, 0)), acc[r]);
            }
        }
    } else if (DTYPE == 3u) {
        // Q5_K (256 elems = 8x32 sub-blocks = 176B = 44 uint32_t)
        const uint sub = lane & 3u;
        const uint blk_step = sg_size >> 2u;
        const uint j0 = sub * 2u;
        const uint j1 = j0 + 1u;
        for (uint ib = (lane >> 2u); ib < nb; ib += blk_step) {
            const uint gblk = x_blk_off + ib;
            const int xq0 = xq[gblk * 8u + j0];
            const int xq1 = xq[gblk * 8u + j1];
            const vec2 dm = xd[gblk];
            const uint isb = ib >> 3u;
            const uint is = ib & 7u;
            const uint chunk = is >> 1u;
            const uint is_hi = is & 1u;

            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                const uint b32 = (row_b[r] >> 1u) + isb * 44u;
                const vec2 wdm = unpackHalf2x16(w32[b32]);
                const uint s0 = w32[b32 + 1u];
                const uint s1 = w32[b32 + 2u];
                const uint s2 = w32[b32 + 3u];
                uint sc, m;
                if (is < 4u) {
                    const uint sh = is * 8u;
                    sc = (s0 >> sh) & 63u;
                    m  = (s1 >> sh) & 63u;
                } else {
                    const uint k = (is - 4u) * 8u;
                    const uint b4  = (s2 >> k) & 0xFFu;
                    const uint bm4 = (s0 >> k) & 0xFFu;
                    const uint b0  = (s1 >> k) & 0xFFu;
                    sc = (b4 & 0x0Fu) | ((bm4 >> 6u) << 4u);
                    m  = (b4 >> 4u)   | ((b0  >> 6u) << 4u);
                }
                const float dw = wdm.x * float(sc);
                const float mw = -wdm.y * float(m);

                const uint ql0 = w32[b32 + 12u + chunk * 8u + j0];
                const uint ql1 = w32[b32 + 12u + chunk * 8u + j1];
                const uint qh0 = w32[b32 + 4u + j0];
                const uint qh1 = w32[b32 + 4u + j1];
                const uint lo0 = (is_hi == 0u) ? (ql0 & 0x0F0F0F0Fu) : ((ql0 >> 4u) & 0x0F0F0F0Fu);
                const uint lo1 = (is_hi == 0u) ? (ql1 & 0x0F0F0F0Fu) : ((ql1 >> 4u) & 0x0F0F0F0Fu);
                const uint hi0 = ((qh0 >> is) & 0x01010101u) << 4u;
                const uint hi1 = ((qh1 >> is) & 0x01010101u) << 4u;

                const int s = sdot4x8(int(lo0 | hi0), xq0, 0) + sdot4x8(int(lo1 | hi1), xq1, 0);
                const float base = (sub == 0u) ? fma(mw, dm.y, acc[r]) : acc[r];
                acc[r] = fma(dw * dm.x, float(s), base);
            }
        }
    }

    [[unroll]] for (uint r = 0u; r < NR; ++r) {
        const float out_v = subgroupAdd(acc[r]);
        if (subgroupElect() && row0 + r < pc.n_out) {
            const uint yi = y_off + row0 + r;
            y[yi] = (pc.add_residual != 0u) ? (y[yi] + out_v) : out_v;
        }
    }
}
